# Supabase project settings — add the real values to .env.local for local work
# and to Vercel Project Settings → Environment Variables before deployment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Used only once to set up the very first system administrator.
# Choose a long, private value and never commit the real value.
ADMIN_SETUP_CODE=choose-a-long-private-setup-code

# Google Sheets sync (Apps Script web-app deployment URL and the matching private sync secret).
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=choose-a-second-long-private-secret

# LINE 商品建立機器人。三個值皆只放在 Vercel / .env.local，絕不可提交到 Git。
# LINE_ALLOWED_USER_IDS 以逗號分隔可使用機器人的 LINE 使用者 ID。
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_ALLOWED_USER_IDS=U1234567890abcdef1234567890abcdef
